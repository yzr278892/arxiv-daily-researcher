{
  // ==================================================
  // Data Source Configuration
  // ==================================================
  "data_sources": {
    // 每日运行结束后自动做一次 gzip 压缩数据库备份
    "enabled": [
      "arxiv"
    ],
    // Optional sources are data-only declarations. Disabled definitions are
    // retained but not fetched; no Python/import path is ever executed.
    "extra_sources": {
      // 本地保留当天全部副本；昨天及更早每天仅留最新一份，再按保留期清理；0 表示保留每日归档
      // WebDAV 为增量备份：仅当数据库内容变化时上传，远端永不删除
      "enabled": true,
      "definitions": []
    },
    "reports_by_source": true,
    "arxiv": {
      "fetch_timeout_seconds": 180,
      "announcement_lookback_grace_days": 2
    },
    // Optional curated supplementary feed; it does not replace arXiv's
    // complete category scan and remains disabled in "enabled" by default.
    "huggingface_papers": {
      "availability_lag_days": 2,
      "lookback_grace_days": 2,
      "request_timeout_seconds": 30,
      "request_interval_seconds": 0.25
    }
  },

  // ==================================================
  // Run Lock Configuration
  // ==================================================
  "run_lock": {
    "max_age_hours": 12
  },

  // ==================================================
  // ArXiv Target Domain Configuration
  // ==================================================
  "target_domains": {
    "domains": [
      "quant-ph"
    ]
  },

  // ==================================================
  // Keyword Configuration
  // ==================================================
  "keywords": {
    "primary_keywords": {
      "weight": 1.0,
      "keywords": []
    },
    "enable_reference_extraction": true,
    "reference_keywords_config": {
      "max_keywords": 10,
      "similarity_threshold": 0.75,
      "weight_distribution": {
        "high_importance": {
          "weight": 1.0,
          "count": 3
        },
        "medium_importance": {
          "weight": 0.2,
          "count": 5
        },
        "low_importance": {
          "weight": 0.1,
          "count": 2
        }
      }
    },
    "research_context": ""
  },

  // ==================================================
  // Scoring Configuration
  // ==================================================
  "scoring_settings": {
    "keyword_relevance_score": {
      "max_score_per_keyword": 10
    },
    "author_bonus": {
      "enabled": false,
      "expert_authors": [],
      "bonus_points": 5.0
    },
    "passing_score_formula": {
      "base_score": 1.5,
      "weight_coefficient": 2.5
    },
    "include_all_in_report": true,
    "strategy": {
      // Switched back to the legacy weighted-keyword formula: it works with
      // reference-only keyword sets, while V2 requires curated primary
      // keywords and degraded to all-keywords-as-core without them.
      "id": "legacy_weighted_keyword_v1",
      "core_relevance_threshold": 6.0,
      "core_keyword_min_score": 7.0,
      "reference_ranking_weight": 0.25,
      "learned_weight_dampening": 0.5,
      "learned_term_weight_cap": 2.0
    }
  },

  // ==================================================
  // Path Configuration
  // ==================================================
  "paths": {
    "data_dir": "data",
    "reference_pdfs": "data/reference_pdfs",
    "reports": "data/reports",
    "downloaded_pdfs": "data/downloaded_pdfs",
    "history_dir": "data/history"
  },

  // ==================================================
  // Keyword Trend Tracking Configuration
  // ==================================================
  "keyword_tracker": {
    "enabled": true,
    "database": {
      "path": "data/keywords/keywords.db"
    },
    "normalization": {
      "enabled": true,
      "batch_size": 25
    },
    "trend_view": {
      "default_days": 30
    },
    "charts": {
      "bar_chart": {
        "top_n": 15
      },
      "trend_chart": {
        "top_n": 5
      }
    },
    "report": {
      "enabled": true,
      "frequency": "weekly"
    }
  },

  // ==================================================
  // Notification Configuration
  // ==================================================
  "notifications": {
    "enabled": true,
    "on_success": true,
    "on_failure": true,
    "attach_reports": true,
    "top_n": 5,
    "channels": {
      "email": {
        "enabled": false
      },
      "wechat_work": {
        "enabled": true
      },
      "dingtalk": {
        "enabled": false
      },
      "telegram": {
        "enabled": false
      },
      "slack": {
        "enabled": false
      },
      "generic_webhook": {
        "enabled": false
      }
    }
  },

  // ==================================================
  // Retry Configuration
  // ==================================================
  "retry": {
    "max_attempts": 5,
    "min_wait": 2,
    "max_wait": 60
  },

  // ==================================================
  // Logging Configuration
  // ==================================================
  "logging": {
    "rotation_type": "time",
    "keep_days": 30
  },

  // ==================================================
  // Concurrency Configuration
  // ==================================================
  "concurrency": {
    "enabled": true,
    "workers": 2
  },
  "llm_request_pool": {
    "enabled": true,
    "requests_per_minute": 30,
    "log_slow_wait_seconds": 5.0
  },
  "llm": {
    "timeout_seconds": 300.0,
    "sdk_max_retries": 1,
    "retry_max_attempts": 5,
    "retry_min_wait": 5,
    "retry_max_wait": 120
  },
  "daily_research": {
    "enable_deep_analysis": true,
    // 0 = process every pending paper; positive values are useful for tests.
    // Fetching is never truncated: excess candidates stay queued in SQLite.
    "max_papers_per_run": 3,
    "run_time": "12:00",
    "db_path": "data/daily_research/daily_research.db"
  },

  // Historical repair and supplement reports use this independent cap.
  // HTML indexing and source-range scans still complete; excess SQLite work
  // remains pending for the next history-maintenance task. 0 = unlimited.
  "history_maintenance": {
    "max_papers_per_run": 3
  },

  // Legacy HTML can always be indexed into SQLite. Enable this only when
  // the same import should also repair missing fields and scan omissions.
  "legacy_history": {
    "full_repair_enabled": false
  },

  // ==================================================
  // PDF Parser Configuration
  // ==================================================
  "pdf_parser": {
    "mode": "pymupdf",
    "mineru_model_version": "vlm",
    "poll_interval": 3,
    "poll_timeout": 300,
    "download_max_bytes": 26214400
  },

  // ==================================================
  // Report Configuration
  // ==================================================
  "report_settings": {
    "enable_html_report": true,
    "enable_markdown_report": true
  },

  // ==================================================
  // Release Update Notification Configuration
  // ==================================================
  "auto_update": {
    // Only checks GitHub Releases and sends a notification. It never pulls
    // code, rebuilds images, or restarts the running installation.
    "enabled": true
  },

  // ==================================================
  // Token Tracking Configuration
  // ==================================================
  "token_tracking": {
    "enabled": true
  },

  // ==================================================
  // Network Proxy Configuration
  // ==================================================
  "proxy": {
    "enabled": false,
    "url": "",
    "no_proxy": "localhost,127.0.0.1",
    "scope": {
      "arxiv": true,
      "openalex": false,
      "huggingface_papers": false,
      "semantic_scholar": false,
      "llm_api": false,
      "notifications": false,
      "webdav": true,
      "update_check": false
    }
  },

  // ==================================================
  // WebDAV Sync Configuration
  // ==================================================
  "webdav": {
    "enabled": true,
    "remote_path": "/arxiv-daily-researcher/",
    "sync_mode": "after_report",
    "cron_schedule": "0 23 * * *",
    "sync_configs": true,
    "sync_history": false,
    "sync_keywords": false,
    "sync_reports": false
  },

  // ==================================================
  // Database Backup Configuration
  // ==================================================
  "backup": {
    "enabled": true,
    "local_retention_days": 7,
    // 当天备份数量上限；0 表示全部保留。昨天及更早每天始终只留最新一份。
    "same_day_max_count": 0
  },

  // ==================================================
  // Trend Research Mode Configuration
  // ==================================================
  "trend_research": {
    "default_date_range_days": 365,
    "max_results": 500,
    "sort_order": "ascending",
    "report_position": "end",
    "generate_tldr": true,
    "tldr_batch_size": 10,
    "output_formats": [
      "markdown",
      "html"
    ],
    "enabled_skills": [
      "comprehensive_analysis"
    ],
    "analysis_prompt": ""
  }
}
